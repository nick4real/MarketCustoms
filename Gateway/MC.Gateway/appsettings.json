{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authService-route": {
        "ClusterId": "profilesService-cluster",
        "Match": {
          "Path": "api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "auth/{**catch-all}"
          }
        ]
      },
      "userService-route": {
        "ClusterId": "profilesService-cluster",
        "Match": {
          "Path": "api/user/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "users/{**catch-all}"
          }
        ]
      },
      "productService-route": {
        "ClusterId": "catalogService-cluster",
        "Match": {
          "Path": "api/products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "products/{**catch-all}"
          }
        ]
      }
    },
    // Adressess initialized at runtime
    "Clusters": {
      "profilesService-cluster": {
        "Destinations": {
          "destination-1": {
            "Address": ""
          }
        }
      },
      "catalogService-cluster": {
        "Destinations": {
          "destination-1": {
            "Address": ""
          }
        }
      }
    }
  }
}
