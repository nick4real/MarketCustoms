{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authService-route": {
        "ClusterId": "",
        "Match": {
          "Path": "api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "auth/{**catch-all}"
          }
        ]
      },
      "profilesService-route": {
        "ClusterId": "",
        "Match": {
          "Path": "api/profiles/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "profiles/{**catch-all}"
          }
        ]
      },
      "catalogService-route": {
        "ClusterId": "",
        "Match": {
          "Path": "api/products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "products/{**catch-all}"
          }
        ]
      },
      "reactWebApp-route": {
        "ClusterId": "",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    }
  }
}
